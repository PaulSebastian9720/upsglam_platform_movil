# Plantilla sin valores reales. Copiar a .env (ignorado por git) y rellenar.
# Qué va en cada sitio: docs/base_de_datos/supabase.md

# ---- Públicos: los usa también la app (--dart-define) ----
SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---- Secretos: solo el backend ----
SUPABASE_SECRET_KEY=sb_secret_...

# Session pooler (IPv4), copiado de "Connect" en el panel, en formato R2DBC.
DB_R2DBC_URL=r2dbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslMode=require
DB_USUARIO=postgres.<ref-del-proyecto>
DB_CLAVE=

# Para validar los tokens de la app (llaves asimétricas de Supabase Auth).
SUPABASE_JWT_ISSUER=https://<ref-del-proyecto>.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://<ref-del-proyecto>.supabase.co/auth/v1/.well-known/jwks.json
