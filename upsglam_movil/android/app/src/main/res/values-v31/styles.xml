<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Se ve mientras arranca el proceso, antes del primer cuadro de Flutter -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/fondo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <!-- Fondo de la ventana detrás de Flutter. La app siempre es oscura -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/fondo</item>
    </style>
</resources>
